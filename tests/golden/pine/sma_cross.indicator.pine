//@version=6
// Nakagai Pine export: sma_cross
// Artifact: indicator. It marks the bars Nakagai would signal on, draws the
// levels that signal froze, and raises one alert for each one. It places no
// orders.
// Generator version: 1
// Spec hash: 54fae37f27bd44e495cef6b9822cc804b8a3f8a50685c1073294885432bbfc2d
//
// Chart: a standard 15-minute candle chart. Heikin Ashi, Renko, Line Break,
// Kagi, Point and Figure, Range and every other synthetic-price chart show
// prices no market printed, so a decision read off one would be fiction. This
// script refuses to run on one, and on a chart of any other length.
// Extended trading hours must be ENABLED on the chart, and this is a
// correctness requirement rather than a coverage one. Nakagai's bars include
// pre-market and post-market prints, so a regular-hours chart is missing bars
// outright. It also opens its session at 09:30 New York, and TradingView
// anchors every intraday aggregate to the session, so a play that requests its
// own timeframe would receive 09:30 to 10:30 bars where Nakagai aggregates on
// the wall clock. This script refuses to run without extended hours.
//
// Assumptions:
//   - The chart must be on 15m bars. Nakagai replays every play on its 15m
//     driving cadence whatever the play's own timeframe says, so the script
//     charts that cadence and requests the play's own timeframe rather than
//     charting it.
//   - This play is on 1h. Its conditions are computed on 1h bars and read on
//     the 15m bar the engine reads them on, and it signals once per 1h bar
//     rather than on every chart bar underneath one.
//   - Every condition is read on the close of its bar.
//   - Pine seeds its recursive averages (ema, rsi, atr and the terms built on
//     them) differently from the engine, so the first bars of a chart can
//     differ.
//   - The chart bar that closes with the 1h bar is where the engine first
//     reads 1h, whether latching a requested value there or only checking
//     time_close("60") for a gate, so it neither repaints nor leads the
//     engine.
//   - This play reads 1h off TradingView's idea of where each bar closes,
//     whether by requesting the bar itself or only gating on its close, and
//     either way TradingView anchors that close to the chart's session. With
//     extended trading hours enabled that session opens at 04:00 New York, so
//     its 60 minute boundaries fall on the same wall-clock lines Nakagai
//     aggregates on and the two agree. That is the one premise of this export
//     nobody has measured on a chart: plot time("60") and read where the
//     boundaries land before trusting a result.
//
// Fidelity boundary. A TradingView result is a separate simulation and is
// never Nakagai evidence:
//   - TradingView and Alpaca can differ in session coverage, adjustments,
//     volume, missing bars, and aggregate boundaries.
//   - Nakagai resolves an ambiguous bar pessimistically with stop first.
//     TradingView infers an intrabar path or uses Bar Magnifier data.
//   - Nakagai uses one basis point of slippage with a one-cent floor. Pine's
//     built-in slippage is a fixed number of ticks, set to one here, which is
//     the same cent on a stock at or under $100 and less than Nakagai charges
//     above it.
//   - Nakagai enforces a T+1 settled-funds ledger. Pine models capital and
//     margin without an equivalent settlement ledger.
//   - TradingView input changes alter the exported play without changing its
//     embedded hash.
//   - Nakagai's daily bars differ from any chart's by construction, measured
//     over ten symbols and three years. They carry a dividend adjustment the
//     intraday bars do not, which moved a high-yield name 8.4% at the far end
//     of that window and a non-payer not at all, and their close is the
//     consolidated official close including the auction rather than the last
//     intraday print. A play on 1d therefore reads different numbers from the
//     engine's, whatever the chart shows.
//
// Editing any input below creates a TradingView-local variation: its results
// no longer represent the spec hash above, and Nakagai cannot read that
// variation back.
indicator("Nakagai · sma_cross", overlay=true)

// --- Chart contract ---
if barstate.isfirst and timeframe.in_seconds() != 15 * 60
    runtime.error("Nakagai Pine exports require a standard 15-minute chart.")
if barstate.isfirst and not chart.is_standard
    runtime.error("Nakagai Pine exports require a standard candle chart.")
if barstate.isfirst and syminfo.session != session.extended
    runtime.error("Nakagai Pine exports require extended trading hours to be enabled: a regular-hours chart is missing bars, and TradingView aggregates its higher timeframes from the 09:30 session open rather than on the wall clock Nakagai uses.")

// --- Inputs ---
nk_long_all_0_lhs_sma_n = input.int(20, "lhs · sma · n", minval=2, maxval=500)
nk_long_all_0_rhs_sma_n = input.int(50, "rhs · sma · n", minval=2, maxval=500)
nk_risk_stop_n = input.int(14, "Risk · stop · n", minval=2, maxval=100)
nk_risk_stop_mult = input.float(2.0, "Risk · stop · mult", minval=0.1, maxval=10.0)
nk_risk_target_rr = input.float(2.0, "Risk · target · rr", minval=0.1, maxval=20.0)

// --- Calculations ---
nk_visible_60 = time_close("60") == time_close

nk_frame_1() =>
    nk_sma_1 = ta.sma(close, nk_long_all_0_lhs_sma_n)
    nk_sma_2 = ta.sma(close, nk_long_all_0_rhs_sma_n)
    bool nk_long_entry_native = (ta.crossover(nk_sma_1, nk_sma_2))
    bool nk_short_entry_native = (ta.crossunder(nk_sma_1, nk_sma_2))
    float nk_risk_stop_distance_native = ta.atr(nk_risk_stop_n) * nk_risk_stop_mult
    [nk_long_entry_native, nk_short_entry_native, nk_risk_stop_distance_native]

[nk_long_entry_raw, nk_short_entry_raw, nk_risk_stop_distance_raw] = request.security(syminfo.tickerid, "60", nk_frame_1(), lookahead=barmerge.lookahead_on, gaps=barmerge.gaps_off)
var bool nk_long_entry = false
var bool nk_short_entry = false
var float nk_risk_stop_distance = na

if nk_visible_60
    nk_long_entry := nk_long_entry_raw
    nk_short_entry := nk_short_entry_raw
    nk_risk_stop_distance := nk_risk_stop_distance_raw

// --- Decisions ---
nk_long_stop = close - nk_risk_stop_distance
nk_long_target = close + nk_risk_target_rr * (close - nk_long_stop)
nk_long_decision = nk_visible_60 and nk_long_entry and not na(nk_long_stop) and nk_long_stop < close and nk_long_target > close
nk_short_stop = close + nk_risk_stop_distance
nk_short_target = close - nk_risk_target_rr * (nk_short_stop - close)
nk_short_decision = nk_visible_60 and nk_short_entry and not na(nk_short_stop) and nk_short_stop > close and nk_short_target < close

// --- Markers ---
plotshape(nk_long_decision, "Nakagai long", shape.triangleup, location.belowbar, color.teal, size=size.tiny)
plotshape(nk_short_decision, "Nakagai short", shape.triangledown, location.abovebar, color.maroon, size=size.tiny)

// --- Alert body ---
nk_signal_json(direction, reference, stop, target) =>
    string head = "{\"schema\":\"nakagai.pine.signal.v1\",\"spec_hash\":\"54fae37f27bd44e495cef6b9822cc804b8a3f8a50685c1073294885432bbfc2d\",\"symbol\":\"" + syminfo.ticker + "\""
    string where = ",\"timeframe\":\"" + timeframe.period + "\",\"direction\":\"" + direction + "\""
    string when = ",\"bar_time\":" + str.tostring(time)
    string levels = ",\"reference\":" + str.tostring(reference) + ",\"stop\":" + str.tostring(stop) + ",\"target\":" + str.tostring(target)
    head + where + when + levels + "}"

// --- Signal levels ---
var float nk_reference = na
var float nk_stop = na
var float nk_target = na
if nk_long_decision
    nk_reference := close
    nk_stop := nk_long_stop
    nk_target := nk_long_target
    alert(nk_signal_json("long", nk_reference, nk_stop, nk_target), alert.freq_once_per_bar_close)
else if nk_short_decision
    nk_reference := close
    nk_stop := nk_short_stop
    nk_target := nk_short_target
    alert(nk_signal_json("short", nk_reference, nk_stop, nk_target), alert.freq_once_per_bar_close)

// --- Level plots ---
plot(nk_reference, "Nakagai reference", color=color.gray, style=plot.style_linebr)
plot(nk_stop, "Nakagai stop", color=color.maroon, style=plot.style_linebr)
plot(nk_target, "Nakagai target", color=color.teal, style=plot.style_linebr)
